# ─── Modulo Formulario · Backend ──────────────────────────────────────
PORT=4002
CORS_ORIGINS=*
JSON_BODY_LIMIT=1mb

# ─── Multi-tenant (Nexus) ─────────────────────────────────────────────
NEXUS_AUTH_ENABLED=true
TENANT_TOKEN_SECRET=
# 18=Formulario RCV · 22=Formulario Funerario · 30=Formulario Catálogo Exélixi
NEXUS_EXPECTED_SUBMODULO_IDS=18,22,30

# ─── nest-api (catálogos INMA + valrep) ───────────────────────────────
# Local:    http://localhost:3002
# srv001:   http://127.0.0.1:3002
NEST_API_URL=http://localhost:3002
# Key creada en http://127.0.0.1:3002/admin/ (canje automático → Bearer)
NEST_API_KEY=
NEST_AUTH_USE_TOKEN=true
# Deprecated (compat srv001): SYSIP_API_URL, SYSIP_API_KEY
LAMUNDIAL_TIMEOUT_MS=30000

# Canal / productor (metadata SSO, referencia)
LAMUNDIAL_PRODUCTOR=80080
LAMUNDIAL_CUSUARIO=4
LAMUNDIAL_RAMO=18
