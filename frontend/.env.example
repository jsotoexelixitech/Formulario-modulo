# ── Build local (dev) ──────────────────────────────────────────────────────────
# cierrelmds:  /formulario/
VITE_APP_BASE=/

# En localhost usa el proxy de Vite (mismo origen) para evitar CORS.
# Remoto directo (solo funciona si el servidor envía ACAO para tu origen):
#   VITE_NEXUS_API_URL=https://cierrelmds.exelixitech.com/nexus-api
VITE_NEXUS_API_URL=/nexus-api

# Destino del proxy Vite (local o cierrelmds)
# Local:      http://127.0.0.1:3092
# cierrelmds: https://cierrelmds.exelixitech.com/nexus-api
VITE_NEXUS_API_PROXY=https://cierrelmds.exelixitech.com/nexus-api

# Solo local: destino del módulo Emisión/Planes (en prod Apache usa /emision)
# Si Vite sube de puerto (5183 ocupado → 5184/5185), ajústalo aquí.
# VITE_EMISION_CONTINUE_BASE=http://localhost:5183

# API Key de empresa (opcional en dev)
VITE_NEXUS_API_KEY=
